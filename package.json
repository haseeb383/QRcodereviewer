{
  "name": "qr-reviewer",
  "version": "1.0.0",
  "description": "Pre-Printed Smart Review Card System",
  "type": "module",
  "scripts": {
    "dev": "vercel dev",
    "build": "echo 'No build step required'",
    "start": "vercel dev",
    "generate-qr": "node src/generate-qr.js",
    "init-db": "node src/database.js",
    "migrate": "node --env-file=.env.local scripts/migrate-to-kv.js",
    "deploy": "vercel --prod"
  },
  "dependencies": {
    "@vercel/kv": "^1.0.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "vercel": "^54.17.3"
  }
}
